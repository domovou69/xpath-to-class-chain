{
  "about": "Single source of truth for the versions the converter was last checked against on a device, and for the upstream files the quarterly watch (audit/upstream/) compares. After a device re-check, update `checked` here first, then README 'Checked with', docs/results.md and audit/harness/wda/VERSION (rebuild and re-run the mini-WDA harness before that: see 'After an issue' in audit/upstream/README.md).",
  "checked": {
    "date": "2026-11-26",
    "appium": "4.0.1",
    "driver": "13.8.0",
    "wda": "17.1.4",
    "xcode": "27.2",
    "ios": { "simulator": "27.0", "iphone": "26.6" }
  },
  "saucelabs": {
    "docs": "https://docs.saucelabs.com/mobile-apps/automated-testing/appium/appium-versions/",
    "repo": "saucelabs/sauce-docs",
    "path": "docs/mobile-apps/automated-testing/appium/appium-versions.md"
  },
  "watch": {
    "wda": {
      "name": "WebDriverAgent",
      "repo": "appium/appium-ios",
      "npm": "appium-webdriveragent",
      "tag": "appium-webdriveragent@{version}",
      "files": [
        "packages/webdriveragent/WebDriverAgentLib/Utilities/FBClassChainQueryParser.h",
        "packages/webdriveragent/WebDriverAgentLib/Utilities/FBClassChainQueryParser.m",
        "packages/webdriveragent/WebDriverAgentLib/Routing/FBElement.h",
        "packages/webdriveragent/WebDriverAgentLib/Utilities/FBElementTypeTransformer.h",
        "packages/webdriveragent/WebDriverAgentLib/Utilities/FBElementTypeTransformer.m",
        "packages/webdriveragent/WebDriverAgentLib/Routing/FBElementUtils.m",
        "packages/webdriveragent/WebDriverAgentLib/Utilities/FBXPathExtensions.h",
        "packages/webdriveragent/WebDriverAgentLib/Utilities/FBXPathExtensions.m",
        "packages/webdriveragent/WebDriverAgentLib/Categories/NSExpression+FBFormat.h",
        "packages/webdriveragent/WebDriverAgentLib/Categories/NSExpression+FBFormat.m",
        "packages/webdriveragent/WebDriverAgentLib/Utilities/NSPredicate+FBFormat.h",
        "packages/webdriveragent/WebDriverAgentLib/Utilities/NSPredicate+FBFormat.m",
        "packages/webdriveragent/WebDriverAgentLib/Categories/XCUIElement+FBClassChain.m",
        "packages/webdriveragent/WebDriverAgentLib/Utilities/FBXPath.h",
        "packages/webdriveragent/WebDriverAgentLib/Utilities/FBXPath.m",
        "packages/webdriveragent/WebDriverAgentLib/Categories/XCUIElement+FBFind.m",
        "packages/webdriveragent/WebDriverAgentLib/Commands/FBFindElementCommands.m",
        "packages/webdriveragent/WebDriverAgentLib/Categories/XCUIElement+FBWebDriverAttributes.m"
      ]
    },
    "driver": {
      "name": "appium-xcuitest-driver",
      "repo": "appium/appium-xcuitest-driver",
      "npm": "appium-xcuitest-driver",
      "tag": "v{version}",
      "files": [
        "lib/commands/find.*",
        "lib/commands/source.*",
        { "path": "lib/driver.*", "match": "locatorStrateg" },
        "docs/reference/settings.md"
      ]
    },
    "appium": {
      "name": "Appium",
      "repo": "appium/appium",
      "npm": "appium",
      "tag": "appium@{version}",
      "files": [
        "packages/base-driver/lib/basedriver/commands/find.*",
        { "path": "packages/base-driver/lib/basedriver/core.*", "match": "ocatorStrateg" }
      ]
    }
  }
}
